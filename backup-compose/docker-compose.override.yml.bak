services:
  frontend:
    image: node:22-alpine
    container_name: lafrenona3_frontend
    working_dir: /app
    restart: unless-stopped
    volumes:
      - ./frontend:/app
      - lafrenona3_frontend_node_modules:/app/node_modules
    ports:
      - "3000:3000"
    command: >
      sh -c "
      npm ci &&
      npm run dev -- --host 0.0.0.0 --port 3000
      "
    depends_on:
      - backend
    networks:
      - lafrenona3_network

volumes:
  lafrenona3_frontend_node_modules:
    driver: local